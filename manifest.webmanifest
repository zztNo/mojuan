  "categories": ["books", "entertainment", "lifestyle"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "我的书架", "short_name": "书架", "url": "./index.html#/shelf", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "逛书城", "short_name": "书城", "url": "./index.html#/store", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "继续阅读", "short_name": "继续读", "url": "./index.html#/shelf", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
