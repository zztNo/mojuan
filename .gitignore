# 构建产物（由 tools/build_standalone.py 重新生成，无需入库）
mojuan-offline.html

# 发版资产（APK 由 PWABuilder 出包，走 Release 附件，不进仓库）
*.apk

# 工具缓存：抓取/拆分书源的中间产物，体积大且可重建
tools/cache/

# 本地项目元数据（WorkBuddy 内部）
.workbuddy/

# 测试运行产生的临时产物
.playwright-cli/

# 依赖
node_modules/

# 桌面打包产物（Electron 构建输出）
desktop/dist/

# 日志
*.log

# Python 字节码缓存
__pycache__/
*.pyc

# 系统文件
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
